# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opshub"

# --- Auth (Google sign-in, limited to ALLOWED_EMAIL_DOMAIN) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAIL_DOMAIN="mainfactor.com"
# Local development only: skip Google sign-in. Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=""

# --- Cron: jobs endpoint requires "Authorization: Bearer $CRON_SECRET" ---
CRON_SECRET=""

# --- Gmail (inbound PO mailbox) ---
GMAIL_MAILBOX="globalinboundupdates@mainfactor.com"
# Option A: Workspace service account with domain-wide delegation (scope gmail.modify).
# Paste the JSON key, or base64 of it.
GMAIL_SA_KEY_JSON=""
# Option B: OAuth for that mailbox.
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""

# --- Claude API (PDF parsing + email fallback) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- ShipHero: one env var per account; Settings stores only the env var NAME ---
# SHIPHERO_TOKEN_MAIN=""
