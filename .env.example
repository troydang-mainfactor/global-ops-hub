# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opshub"

# --- Auth (Google sign-in, limited to ALLOWED_EMAIL_DOMAIN) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAIL_DOMAIN="mainfactor.com"
# Local development only: skip Google sign-in. Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=""

# --- Cron: jobs endpoint requires "Authorization: Bearer $CRON_SECRET" ---
CRON_SECRET=""

# --- Gmail (the mailbox that receives the PO emails) ---
# Can be your own Gmail with the PO emails forwarded to it. The app reads ONLY messages that match the
# Gmail search set in Settings (default: label:ops-hub-inbound), read-only.
GMAIL_MAILBOX="you@mainfactor.com"
# Option A: OAuth for that one mailbox (simplest for a personal mailbox).
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""
# Option B: Workspace service account with domain-wide delegation (admin needed; covers every mailbox in the domain).
GMAIL_SA_KEY_JSON=""
# Optional: "1" adds ops-hub/processed labels in Gmail (needs the broader gmail.modify scope). Off = read-only.
GMAIL_APPLY_LABELS=""

# --- Claude API (PDF parsing + email fallback) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- ShipHero: one login per warehouse; Settings stores only these env var NAMES ---
SHIPHERO_TOKEN_MICHIGAN=""   # refresh token for the Mainfactor Michigan login
SHIPHERO_TOKEN_PHILLY=""     # refresh token for the Mainfactor Philly login (later)
